# Manifest for src/components/icons/syncIcons.h — regenerate with:
#   python3 scripts/generate_icons.py --library lucide \
#     --manifest src/components/icons/syncIcons.manifest \
#     --sizes 20 --stroke-width 2.5 --out src/components/icons/syncIcons.h
# then clang-format -i the output.
# KOSync state badges next to a book's % on Home and left of Library row icons.
cloud = cloud
cloud-off = cloud-off
cloud-download = cloud-download
cloud-upload = cloud-upload
