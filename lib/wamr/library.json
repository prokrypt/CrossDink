{
  "name": "wamr",
  "version": "2.4.0",
  "description": "Vendored WAMR (wasm-micro-runtime) classic interpreter subset for Goodies SD modules (x4-pro-debug only)",
  "license": "Apache-2.0 WITH LLVM-exception",
  "frameworks": "*",
  "platforms": "espressif32",
  "build": {
    "includeDir": "core/iwasm/include",
    "srcFilter": [
      "+<core/iwasm/common/*.c>",
      "+<core/iwasm/common/arch/invokeNative_xtensa.s>",
      "+<core/iwasm/interpreter/*.c>",
      "+<core/shared/platform/esp-idf/*.c>",
      "+<core/shared/platform/common/libc-util/*.c>",
      "+<core/shared/utils/*.c>",
      "+<core/shared/mem-alloc/*.c>",
      "+<core/shared/mem-alloc/ems/*.c>"
    ],
    "flags": [
      "-Icore",
      "-Icore/iwasm/common",
      "-Icore/iwasm/interpreter",
      "-Icore/shared/utils",
      "-Icore/shared/mem-alloc",
      "-Icore/shared/platform/include",
      "-Icore/shared/platform/esp-idf",
      "-Icore/shared/platform/common/libc-util",
      "-DBUILD_TARGET_XTENSA",
      "-DBH_PLATFORM_ESP_IDF",
      "-DBH_MALLOC=wasm_runtime_malloc",
      "-DBH_FREE=wasm_runtime_free",
      "-DWASM_ENABLE_INTERP=1",
      "-DWASM_ENABLE_FAST_INTERP=0",
      "-DWASM_ENABLE_AOT=0",
      "-DWASM_ENABLE_LIBC_BUILTIN=0",
      "-DWASM_ENABLE_LIBC_WASI=0",
      "-DWASM_ENABLE_BULK_MEMORY=0",
      "-DWASM_ENABLE_REF_TYPES=0",
      "-DWASM_ENABLE_SIMD=0",
      "-DWASM_ENABLE_MULTI_MODULE=0",
      "-DWASM_ENABLE_SHARED_MEMORY=0",
      "-DWASM_ENABLE_MINI_LOADER=0",
      "-DWASM_DISABLE_HW_BOUND_CHECK=1",
      "-DWASM_DISABLE_STACK_HW_BOUND_CHECK=1",
      "-DWASM_DISABLE_WAKEUP_BLOCKING_OP=1",
      "-DWASM_MEM_ALLOC_WITH_USAGE=1",
      "-Wno-format",
      "-Wno-type-limits",
      "-Wno-unused-variable",
      "-Wno-unused-function"
    ]
  }
}
