// Goodies > Knobs, one row each: X(group, id, type, default, min, max, step, unit).
// type and default are the constant's own, so release builds are unchanged.
// Never add LUT shapes, VCOM, voltages, TSSET, PSR/CDI/power registers, raw
// PLL bytes, CPU/PM config, task stacks or anything that sizes an array:
// display frame counts reach only the SDK's DC-balance-gated LUT generators.
// Included once per expansion (no include guard).

// Display: SDK Uc8179Driver (setUc8179Tuning) and the Turbo keyboard
X("Display", paintFrames, uint8_t, 12, 6, 24, 1, "fr")                 // exit paint / smooth base DU frames per phase
X("Display", coldDivisor, uint8_t, 3, 0, 10, 1, "1/n")                 // cold panel adds frames / n, 0 = none
X("Display", heldRedriveFrames, uint8_t, 3, 0, 16, 1, "fr")            // Softfast held-black (KK) re-drive, gated sets
X("Display", coldC, int8_t, 15, -10, 40, 1, "C")                       // panel counts as cold below this
X("Display", tempPeriodMs, uint32_t, 60000, 10000, 600000, 10000, "ms")          // idle temperature sample
X("Display", tempRefreshPeriodMs, uint32_t, 300000, 10000, 1800000, 10000, "ms")  // after-refresh sample
X("Display", tempMaxAgeMs, uint32_t, 600000, 60000, 3600000, 60000, "ms")        // older samples ignored
X("Display", kbdFrames, uint8_t, 4, 2, 16, 1, "fr")                    // Turbo keyboard DU frames per phase
X("Display", kbdPll, uint8_t, 0, 0, 2, 1, "")                          // Turbo keyboard PLL: panel, 1 = 40 Hz, 2 = 50 Hz

// Frontlight
// Flash duck, per waveform: dark this much after the swing the driver reports, back up this much after
// the refresh ends. AA page (direct gray, log 20260930T213400Z-14588105-psram-duck): text flashes from DRF,
// 571 ms before the reported background swing; up fade (flashUpMs) done ~200 ms before the 1192 ms end.
// Half/Full (OTP GC) and DU paints (menus, drawer over gray; 2 x 12 frames ~663 ms) swing from DRF and
// flash to their end, so the up fade ends with the refresh.
X("Light", flashGrayDimMs, int32_t, -570, -800, 800, 10, "ms")         // AA page turn
X("Light", flashGrayRestoreMs, int32_t, -500, -800, 800, 10, "ms")
X("Light", flashFullDimMs, int32_t, 0, -800, 800, 10, "ms")            // Half/Full
X("Light", flashFullRestoreMs, int32_t, -300, -800, 800, 10, "ms")
X("Light", flashPaintDimMs, int32_t, 0, -800, 800, 10, "ms")           // menu / drawer over gray
X("Light", flashPaintRestoreMs, int32_t, -300, -800, 800, 10, "ms")
X("Light", flashDownMs, unsigned long, 80, 0, 500, 10, "ms")           // flash duck fade out
X("Light", flashUpMs, unsigned long, 300, 0, 2000, 50, "ms")           // flash duck fade in
X("Light", flashMaxMs, unsigned long, 3000, 500, 10000, 500, "ms")     // a flash mark older than this is dropped
X("Light", flashTickMs, uint32_t, 10, 5, 50, 5, "ms")                  // main loop tick while ducking
X("Light", lightFadeMs, unsigned long, 1000, 0, 5000, 100, "ms")       // Light Timeout fade
X("Light", pulseCycleMs, uint32_t, 1000, 200, 5000, 100, "ms")         // transfer pulse period
X("Light", pulsePeakPct, uint8_t, 25, 20, 100, 1, "%")                 // transfer pulse peak (above any floor)
X("Light", pulseFloorPct, uint8_t, 10, 0, 20, 1, "%")                  // pulse floor when the light was on
X("Light", pulseTailMs, unsigned long, 250, 0, 2000, 50, "ms")         // transfer counts as active this long after
X("Light", pulseWriteMs, uint32_t, 20, 10, 100, 5, "ms")               // min gap between pulse writes (loop tick)
X("Light", pulseHoldMs, uint32_t, 10000, 0, 60000, 1000, "ms")         // a lit light keeps its level this long first
X("Light", otaPulseGraceMs, uint32_t, 1500, 0, 10000, 250, "ms")       // OTA pulse ends this long after the stream
X("Light", panelStep, int, 5, 1, 20, 1, "%")                           // Frontlight panel button step
X("Light", panelFineStep, int, 1, 1, 10, 1, "%")                       // Frontlight panel touch step

// Touch and buttons (SDK InputManager thresholds pushed by InputManager::setTuning)
X("Touch", swipeDeadPx, int, 60, 20, 200, 5, "px")           // swipe/slide dead zone floor (edge, two-finger, light)
X("Touch", swipeDeadPct, int, 6, 0, 20, 1, "%")              // dead zone as % of the axis, if larger
X("Touch", swipeFullAxisPts, int, 50, 10, 100, 5, "pts")     // light points a full-axis swipe covers
X("Touch", edgeBandPx, int, 32, 16, 120, 4, "px")            // edge-slide band floor
X("Touch", edgeBandPct, int, 8, 2, 25, 1, "%")               // edge-slide band as % of width, if larger
X("Touch", backEdgePermille, int, 250, 50, 500, 10, "/1000") // Back swipe start zone (left)
X("Touch", homeEdgePermille, int, 60, 20, 250, 10, "/1000")  // Home swipe zone (bottom)
X("Touch", readerHomeEdgePermille, int, 120, 20, 250, 10, "/1000")  // Home swipe zone in the reader
X("Touch", menuEdgePermille, int, 140, 20, 300, 10, "/1000")        // menu swipe zone (top)
X("Touch", heldOverrideMs, unsigned long, 250, 50, 1000, 50, "ms")  // a gesture's held-time override lasts
X("Touch", selectPressDelayMs, unsigned long, 200, 50, 1000, 10, "ms")  // still hold before the row highlight
X("Touch", selectPressSlopPx, int, 20, 4, 60, 2, "px")              // movement that cancels it
X("Touch", tapSlopPx, int, 28, 4, 56, 2, "px")                      // SDK: tap / long-press slop (< swipe min)
X("Touch", swipeMinPx, int, 60, 20, 200, 5, "px")                   // SDK: min swipe (tap-on-release slop - 1)
X("Touch", swipeMaxMs, unsigned long, 700, 200, 3000, 50, "ms")     // SDK: longest one-finger swipe
X("Touch", multiSwipeMaxMs, unsigned long, 2000, 500, 5000, 100, "ms")  // SDK: two-finger gesture window
X("Touch", multiSeparationSlopPx, int, 45, 10, 150, 5, "px")        // SDK: two-finger spacing tolerance
X("Touch", touchLongPressMs, unsigned long, 500, 200, 2000, 50, "ms")  // SDK: screen long press
X("Touch", touchIrqPulseMs, unsigned long, 120, 20, 500, 10, "ms")  // SDK: release hold-over after last read
X("Touch", pinchMinPx, uint8_t, 20, 5, 80, 1, "px")                 // reader pinch: min span change
X("Touch", pinchScalePct, uint8_t, 110, 102, 200, 1, "%")           // reader pinch: span ratio per font step
X("Touch", homeKeyLongMs, unsigned long, 700, 300, 2000, 50, "ms")  // SDK: Home key long press
X("Touch", homeDoubleTapMs, unsigned long, 300, 100, 1500, 25, "ms")  // Home key double tap (< idle backoff)
X("Touch", confirmBackHoldMs, unsigned long, 650, 200, 2000, 50, "ms")   // SDK: Confirm+Back chord
X("Touch", confirmPowerHoldMs, unsigned long, 400, 200, 2000, 50, "ms")  // SDK: Confirm+Power chord
X("Touch", twoButtonHoldMs, unsigned long, 650, 200, 2000, 50, "ms")     // SDK: two-button chord
X("Touch", skipHoldMs, unsigned long, 700, 200, 3000, 50, "ms")     // side-button hold: chapter skip
X("Touch", goHomeHoldMs, unsigned long, 1000, 300, 3000, 50, "ms")  // Back hold: Home (reader, file browser)
X("Touch", deleteHoldMs, unsigned long, 1000, 300, 3000, 50, "ms")  // hold to delete bookmark/clipping
X("Touch", menuHoldMs, unsigned long, 600, 200, 3000, 50, "ms")     // reader long press: menu
X("Touch", dictHoldMs, unsigned long, 1000, 200, 3000, 50, "ms")    // reader touch hold: dictionary
X("Touch", dictBackHoldMs, unsigned long, 600, 200, 3000, 50, "ms") // dictionary Back/Done long press
X("Touch", homeBookSwapMs, unsigned long, 1000, 300, 3000, 50, "ms")  // Home: long press swaps the book
X("Touch", kbdHoldMs, uint16_t, 500, 200, 2000, 50, "ms")           // keyboard button long press
X("Touch", kbdDelHoldMs, uint16_t, 1500, 300, 3000, 50, "ms")       // keyboard Delete long press
X("Touch", kbdTouchHoldMs, uint16_t, 350, 150, 2000, 50, "ms")      // keyboard key touch long press
X("Touch", kbdTouchDelHoldMs, uint16_t, 900, 200, 3000, 50, "ms")   // keyboard Delete touch long press
X("Touch", kbdHighlightDelayMs, uint16_t, 120, 0, 500, 10, "ms")    // keyboard key highlight delay
X("Touch", inputActivePollMs, uint32_t, 8, 4, 50, 1, "ms")          // input task tick while input is held

// Power
X("Power", idlePowerSaveMs, unsigned long, 250, 50, 5000, 50, "ms")    // idle before low clock and long waits
X("Power", idleWaitMs, uint32_t, 50, 10, 250, 10, "ms")                // fast idle tick
X("Power", idleWaitSettledMs, uint32_t, 250, 50, 1000, 50, "ms")       // settled idle tick
X("Power", idleWaitLongMs, uint32_t, 1000, 250, 5000, 250, "ms")       // deep idle tick
X("Power", idleBackoffAfterMs, unsigned long, 2000, 2000, 10000, 500, "ms")  // idle before backing off
X("Power", idleLongAfterMs, unsigned long, 10000, 2000, 60000, 1000, "ms")   // idle before the deep tick
X("Power", panelIdleOffMs, uint32_t, 10000, 2000, 60000, 1000, "ms")   // booster off after an early wake
X("Power", batteryPollMs, unsigned long, 6000, 1000, 60000, 1000, "ms")  // battery gauge cache
X("Power", clockPollMs, unsigned long, 10000, 1000, 60000, 1000, "ms")   // RTC cache
X("Power", tiltPollMs, unsigned long, 50, 20, 500, 10, "ms")             // tilt sensor poll
X("Power", tiltCooldownMs, unsigned long, 600, 100, 3000, 50, "ms")      // min time between tilt flicks
X("Power", bootSleepGraceMs, unsigned long, 2000, 0, 10000, 500, "ms")   // power actions ignored after boot

// Memory gates (the minimums are floors)
X("Heap", netExitMinBlock, uint32_t, 49152, 24576, 131072, 1024, "B")    // leave Wi-Fi in place (else restart)
X("Heap", netEntryMinFree, uint32_t, 98304, 65536, 196608, 1024, "B")    // enter Wi-Fi in place
X("Heap", netEntryMinBlock, uint32_t, 49152, 32768, 131072, 1024, "B")
X("Heap", rebuildMinFree, uint32_t, 98304, 65536, 196608, 1024, "B")     // optional EPUB rebuild / prefetch
X("Heap", rebuildMinBlock, uint32_t, 49152, 32768, 131072, 1024, "B")
X("Heap", layoutMinFree, uint32_t, 45056, 32768, 131072, 1024, "B")      // chapter layout start
X("Heap", dictFontMinFree, uint32_t, 65536, 32768, 131072, 1024, "B")    // dictionary SD font
X("Heap", dictFontMinBlock, uint32_t, 32768, 16384, 131072, 1024, "B")
X("Heap", sectionPrewarmMinFree, uint32_t, 81920, 49152, 196608, 1024, "B")  // SD font prewarm at section start
X("Heap", sectionPrewarmMinBlock, uint32_t, 24576, 16384, 131072, 1024, "B")
X("Heap", idlePrewarmMinFree, uint32_t, 65536, 40960, 196608, 1024, "B")     // idle SD font prewarm
X("Heap", idlePrewarmMinBlock, uint32_t, 40960, 24576, 131072, 1024, "B")
X("Heap", richTableMinFree, uint32_t, 98304, 65536, 196608, 1024, "B")       // rich table layout
X("Heap", richTableMinBlock, uint32_t, 57344, 40960, 131072, 1024, "B")
X("Heap", opdsPreloadMinFree, size_t, 49152, 32768, 131072, 1024, "B")       // OPDS preload base floor
X("Heap", opdsPreloadPerWorker, size_t, 16384, 8192, 65536, 1024, "B")       // added per running worker
X("Heap", opdsPreloadMinBlock, size_t, 16384, 8192, 65536, 1024, "B")

// Reader
X("Reader", buildAheadPages, int, 5, 1, 20, 1, "pg")                  // incremental build runs this far ahead
X("Reader", partialRebuildMargin, int, 15, 2, 50, 1, "pg")            // extend a partial section this near its end
X("Reader", buildChunkPages, int, 8, 1, 32, 1, "pg")                  // non-interactive build batch
X("Reader", popupPages, int, 20, 1, 200, 1, "pg")                     // indexing popup: target deeper than this
X("Reader", popupBytes, size_t, 98304, 8192, 524288, 8192, "B")       // indexing popup: spine items this large
X("Reader", popupDeadlineMs, unsigned long, 1000, 100, 5000, 100, "ms")  // indexing popup: build stalls this long
X("Reader", pageTurnGapMs, unsigned long, 200, 0, 1000, 10, "ms")     // faster manual turns are queued
X("Reader", progressSavePages, uint8_t, 30, 1, 255, 1, "pg")          // save progress every N turns (next book)
X("Reader", progressSaveMaxMs, unsigned long, 900000, 60000, 3600000, 60000, "ms")  // and at least this often
X("Reader", homeThumbIdleMs, unsigned long, 3000, 500, 30000, 500, "ms")  // idle before the Home cover thumb
X("Reader", fontPrewarmDelayMs, unsigned long, 400, 0, 5000, 100, "ms")   // idle before the SD font prewarm
X("Reader", pageLoadRetries, int, 3, 1, 10, 1, "")                        // page load retries
X("Reader", pxcCacheCap, size_t, 131072, 32768, 131072, 8192, "B")        // decoded image cache (compiled max)
X("Reader", opdsCacheCap, size_t, 2097152, 262144, 2097152, 262144, "B")  // OPDS page cache (compiled max)

// Wi-Fi
X("Wi-Fi", rejoinTimeoutMs, uint32_t, 20000, 5000, 60000, 1000, "ms")       // Goodies remote join timeout
