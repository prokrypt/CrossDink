X("Wi-Fi", rejoinRetryMaxMs, uint32_t, 600000, 60000, 3600000, 60000, "ms") // retry cap
X("Wi-Fi", rejoinBootDelayMs, uint32_t, 5000, 0, 60000, 1000, "ms")         // no rejoin this soon after boot
X("Wi-Fi", rejoinIdleMs, uint32_t, 2000, 0, 30000, 500, "ms")               // input pause before a rejoin
X("Wi-Fi", connectTimeoutMs, unsigned long, 15000, 5000, 60000, 1000, "ms") // manual join
X("Wi-Fi", autoConnectTimeoutMs, unsigned long, 7000, 2000, 60000, 1000, "ms")  // saved-network join
X("Wi-Fi", hintedConnectTimeoutMs, unsigned long, 6000, 1000, 30000, 1000, "ms")  // BSSID/channel join first
X("Wi-Fi", wifiAbandonMs, unsigned long, 300000, 30000, 1800000, 30000, "ms")  // File Transfer gives up on lost Wi-Fi
X("Wi-Fi", transferLingerMs, unsigned long, 500, 0, 5000, 100, "ms")        // full clock after the last byte
X("Wi-Fi", serverIdlePollMs, uint32_t, 100, 10, 500, 10, "ms")              // web server idle poll
X("Wi-Fi", serverActivePasses, int, 64, 1, 256, 1, "")                      // handleClient passes per tick
X("Wi-Fi", httpTimeoutMs, int, 60000, 5000, 120000, 5000, "ms")             // download HTTP timeout
X("Wi-Fi", httpReadPollMs, int, 5000, 500, 30000, 500, "ms")                // download per-read poll
X("Wi-Fi", downloadIdleMs, uint32_t, 30000, 5000, 120000, 5000, "ms")       // download aborts after no bytes
X("Wi-Fi", opdsStallMs, uint32_t, 10000, 2000, 60000, 1000, "ms")           // OPDS book body stall
X("Wi-Fi", opdsKeepaliveMs, unsigned long, 4000, 0, 30000, 500, "ms")       // idle OPDS connection kept
X("Wi-Fi", kosyncTimeoutMs, uint32_t, 8000, 2000, 60000, 1000, "ms")        // KOReader sync HTTP timeout
X("Wi-Fi", nearbyHelloMs, uint32_t, 750, 100, 5000, 50, "ms")               // Nearby stats hello interval
X("Wi-Fi", nearbyRetryMs, uint32_t, 750, 100, 5000, 50, "ms")               // Nearby stats retry
